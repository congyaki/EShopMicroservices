{
  "GlobalConfiguration": {
    "BaseUrl": "https://api-gateway",
    "RateLimitOptions": {
      "ClientWhitelist": [],
      "EnableRateLimiting": true,
      "Period": "1s",
      "PeriodTimespan": 1,
      "Limit": 10,
      "HttpStatusCode": 429
    },
    "LoadBalancerOptions": {
      "Type": "RoundRobin",
      "Key": "",
      "Expiry": 0
    },
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    }
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-api-1",
          "Port": 443
        },
        {
          "Host": "auth-api-2",
          "Port": 443
        },
        {
          "Host": "auth-api-3",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "",
        "AllowedScopes": []
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/api/v1/catalog/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "catalog-api-1",
          "Port": 443
        },
        {
          "Host": "catalog-api-2",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/v1/catalog/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/api/v1/ordering/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordering-api-1",
          "Port": 443
        },
        {
          "Host": "ordering-api-2",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/v1/ordering/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/api/v1/basket/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "basket-api-1",
          "Port": 443
        },
        {
          "Host": "basket-api-2",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/v1/basket/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    }
  ]
}
