{
  "GlobalConfiguration": {
    "BaseUrl": "http://ocelotapigateway",
    "RateLimitOptions": {
      "ClientWhitelist": [],
      "EnableRateLimiting": true,
      "Period": "1s",
      "PeriodTimespan": 1,
      "Limit": 50,
      "HttpStatusCode": 429
    },
    "LoadBalancerOptions": {
      "Type": "RoundRobin",
      "Key": "",
      "Expiry": 0
    },
    //"ServiceDiscoveryProvider": {
    //  "Host": "consul",
    //  "Port": 8500,
    //  "Type": "Consul"
    //}
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-api-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/auth-service/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "AuthenticationOptions": null,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "catalog-api-1",
          "Port": 80
        },
        {
          "Host": "catalog-api-2",
          "Port": 80
        },
        {
          "Host": "catalog-api-3",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/catalog-service/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": null,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordering-api-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/ordering-service/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": null,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "basket-api-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/basket-service/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": null,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    }
  ]
}
