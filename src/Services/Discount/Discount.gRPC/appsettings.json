{
  "ConnectionStrings": {
    "Database": "Data Source=discountdb"
  },
  "ServiceConfig": {
    "ServiceName": "discount-service",
    "ServiceAddress": "http://localhost",
    "ServicePort": 5003,
    "ConsulHost": "localhost",
    "ConsulPort": 8500
  },
  "DiscountSeedingOptions": {
    "StartupDelaySeconds": 5,
    "BatchSize": 200,
    "DelayBetweenBatchesMs": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  
  "LeaderElection": {
    "Provider": "Consul",
    "ServiceName": "discount-grpc"
  },
  
  "Consul": {
    "Address": "http://consul:8500"
  }
}
